[Unit]
Description=Waylight greeter configuration service
Documentation=https://github.com/metalgrid/waylight
# Started on demand by D-Bus activation; no static enablement needed.

[Service]
Type=dbus
BusName=dev.waylight.Config
User=root
ExecStart=/usr/bin/waylight-configd
Restart=on-failure
# The daemon only writes /etc/waylight and talks on the system bus (AF_UNIX).
# ReadWritePaths is prefixed with - because /etc/waylight may not exist until
# the daemon creates it 0755 on first write.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/etc/waylight
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
